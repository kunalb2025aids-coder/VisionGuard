# ─── VisionGuard AI 2.0 — Environment Configuration ───────────────────────

# App Settings
APP_NAME="VisionGuard AI 2.0"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# ─── Database ─────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
# DATABASE_URL=sqlite:///./visionguard.db

# PostgreSQL (optional, falls back to SQLite if unreachable):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visionguard"

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for development only.
ALLOWED_ORIGINS="*"

# ─── YOLO Model ───────────────────────────────────────────────────────────
MODEL_PATH="models/best.pt"
CONFIDENCE_THRESHOLD=0.25

# ─── Email Alerts (SMTP, optional) ────────────────────────────────────────
SMTP_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="alerts@visionguard.ai"
SMTP_PASSWORD="your-smtp-app-password"
ALERT_RECIPIENT_EMAIL="maintenance-team@factory.com"
MANAGER_EMAIL="manager@factory.com"
SUPERVISOR_EMAIL="supervisor@factory.com"

# ─── AI Copilot LLM (optional) ────────────────────────────────────────────
# Supported providers: openai, google
# Leave LLM_PROVIDER empty to disable LLM (evidence retrieval still works)
LLM_PROVIDER=""
LLM_API_KEY="your-api-key-here"
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024

# ─── Simulation ───────────────────────────────────────────────────────────
# Default simulation scenario: normal | vibration_increase | temperature_anomaly
# | belt_speed_variation | combined_anomaly
DEFAULT_SIMULATION_SCENARIO="normal"
